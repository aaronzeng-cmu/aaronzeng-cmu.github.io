{% capture footer_copyright %}
  &copy; {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}
  {% if site.impressum_path %}
    · <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>
  {% endif %}
  {% if site.last_updated %}
    · Last updated {{ 'now' | date: '%B %d, %Y' }}
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">{{ footer_copyright }}. {{ site.footer_text }}</div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container footer-row">
      <span>{{ footer_copyright }}</span>
      <span class="footer-credit">{{ site.footer_text }}</span>
    </div>
  </footer>
{% endif %}
